<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>crm-minimal</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>MiniCRM (aiup-vaadin-holon demo)</name>
    <description>Minimal CRM demo built with the aiup-vaadin-holon plugin (Holon Platform + Vaadin Flow)</description>

    <!--
        NOTE: deliberately NOT inheriting from com.holon-platform.multi-tenancy:holon-multi-tenancy-root
        as <parent>. That root pom's own dependencyManagement declares every
        holon-multi-tenancy module version as ${project.version}; once inherited, entries
        already present from that inheritance take precedence over the same GA coming from
        an imported BOM (Maven does not let imported entries override ones already merged in
        from a parent), so ${project.version} still resolves against THIS project's version
        instead of the framework's actual 1.0.0. Importing the BOM standalone (as the BOM's
        own pom.xml documents) avoids the conflict entirely.
    -->
    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.0</spring-boot.version>
        <!--
            Gate for booting the full Vaadin app during the integration-test phase.
            Default true (skipped) so `mvn install`/`mvn verify` stays fast. The `it`
            profile flips this to false; you can also override on the CLI:
                mvn verify -Pit
                mvn verify -Dskip.boot.its=false
        -->
        <skip.boot.its>true</skip.boot.its>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.holon-platform.multi-tenancy</groupId>
                <artifactId>holon-multi-tenancy-bom</artifactId>
                <version>1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.holon-platform.vaadin</groupId>
                <artifactId>holon-vaadin-flow-bom</artifactId>
                <version>12.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>vaadin-bom</artifactId>
                <version>25.2.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!--  All-in-one SaaS starter (pulls every module)  -->
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-starter-multi-tenancy</artifactId>
        </dependency>

        <dependency>
            <groupId>com.holon-platform.vaadin</groupId>
            <artifactId>holon-starter-vaadin-flow</artifactId>
        </dependency>

        <!--  Holon: JPA (Hibernate) starter  the multi-tenancy starter wires a tenant-aware
              DataSource but does not itself expose a Holon Datastore bean; CustomerService/
              ContactService/TaxCodeService (BeanDatastoreHelper-backed) need one. Requires
              @Entity-annotated JPA entities on the classpath (JPA Datastore reads/writes through
              the persistence unit rather than plain SQL).  -->
        <dependency>
            <groupId>com.holon-platform.jpa</groupId>
            <artifactId>holon-starter-jpa-hibernate</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>


        <!--  Spring Boot web (embedded Tomcat, DispatcherServlet)  -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--  H2 (replaces all in-memory service implementations); persistence is now driven by
              Holon's JPA Datastore (holon-starter-jpa-hibernate above, which pulls in
              spring-boot-starter-data-jpa/Hibernate transitively), so CustomerService/ContactService/
              TaxCodeService entities must be @Entity-annotated JavaBeans mapped to this schema.  -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--  Redis-backed TenantDetailsCacheStore — a single cache shared across every app
              instance, so an admin suspend/plan-change is visible everywhere immediately (not
              just after the per-instance TTL). Activates automatically once a RedisConnectionFactory
              bean exists (see spring-boot-starter-data-redis below + spring.data.redis.* in
              application.properties); falls back to the per-JVM in-memory cache otherwise.  -->
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-multi-tenant-cache-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--  Auto-starts the Redis service declared in compose.yaml (docker compose up) when
              running locally via `mvn spring-boot:run`; no-op in prod/CI where spring.data.redis.*
              already points at a real Redis instance and no compose.yaml is on the classpath path.  -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-docker-compose</artifactId>
            <optional>true</optional>
        </dependency>

        <!--  Flyway  applies src/main/resources/db/migration (and, on the test classpath,
              src/test/resources/db/migration test-seed scripts) against the H2 datasource.
              Spring Boot 4's autoconfigure modularization moved FlywayAutoConfiguration out of
              spring-boot-autoconfigure into its own standalone module; without this explicit
              dependency, flyway-core sits on the classpath but nothing ever triggers a migration
              (confirmed via `debug=true` condition-evaluation report: FlywayAutoConfiguration
              never even appears as a candidate without this module present).  -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!--  AOP (enables @RateLimit and @Audited aspects)  -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
            <version>3.5.14</version>
            <!-- version managed by spring-boot-dependencies BOM -->
        </dependency>

        <!-- Dev tools (hot-reload for development) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--  Vaadin Browserless testing (server-side, no browser) per the official guide:
              https://vaadin.com/docs/latest/flow/testing/browserless/getting-started
              Provides SpringBrowserlessTest + the find()/test()/navigate() API. The Vaadin BOM
              (25.2.1) does not yet manage this artifact, so the version is pinned to the 1.1.x
              line that targets Vaadin 25.2 (1.0.x targeted 25.1.0-rc and references components,
              e.g. a since-removed Slider, that no longer exist in 25.2).  -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>browserless-test-spring</artifactId>
            <version>1.1.2</version>
            <scope>test</scope>
        </dependency>

        <!--  Playwright  browser-driven end-to-end tests (UC-S-001 Create Customer).
              Blackbox: drives the running app at http://localhost:8080 only. Executed by
              maven-failsafe-plugin in the `it` profile (*IT classes), NOT surefire, so the
              unit test run stays browser-free. Install the browser binaries once via the
              Playwright CLI (see README / SKILL for the exact install command).  -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.49.0</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- P6Spy — SQL logging proxy (raw library, no Spring Boot starter needed) -->
        <dependency>
            <groupId>p6spy</groupId>
            <artifactId>p6spy</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>


    </dependencies>

    <build>
        <plugins>

            <!--
                Compiler  explicitly declared so IntelliJ recognises the source level
                even before the parent pluginManagement is fully resolved.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!--
                Spring Boot plugin  produces the runnable fat-jar (repackage),
                and exposes the run / start / stop goals for development and
                integration-test lifecycles.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <!-- Explicit main class so the plugin never has to guess. -->
                    <mainClass>com.example.crm.CrmApplication</mainClass>
                </configuration>
                <executions>
                    <!--
                        start/stop are skipped by default (skip.boot.its=true).
                        They are gated behind a property so that `mvn install`
                        does NOT try to boot the full Vaadin app during the
                        integration-test phase (Vaadin dev-mode scanning takes
                        > 30 s and always exceeded the default JMX timeout).

                        To run integration tests with the live server:
                            mvn verify -Dskip.boot.its=false
                    -->
                    <execution>
                        <id>pre-integration-test</id>
                        <goals>
                            <goal>start</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.boot.its}</skip>
                            <!-- Vaadin dev-mode frontend scan can take minutes on a cold
                                 start; give the JMX readiness handshake up to ~5 min
                                 (wait 2s * 150 attempts) instead of the 30s default. -->
                            <wait>2000</wait>
                            <maxAttempts>150</maxAttempts>
                        </configuration>
                    </execution>
                    <execution>
                        <id>post-integration-test</id>
                        <goals>
                            <goal>stop</goal>
                        </goals>
                        <configuration>
                            <skip>${skip.boot.its}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

    <!--
        SonarQube-equivalent quality gate (see ../../aiup-vaadin-holon/rules/quality-gate.md).
        This module IS the reference implementation that rule doc points to, so this profile
        was authored from scratch (no other config/ rulesets existed anywhere in the monorepo
        to copy from). Bound to `verify`; opt-in via `-Pquality` so a plain `mvn package`/`mvn
        test` stays fast. Every plugin below runs in REPORT mode (non-failing) by default -
        see the properties block for the exact toggles that flip each one into a hard gate.
    -->
    <profiles>

        <!--
            Integration / end-to-end tests (Playwright, UC-S-001). Opt-in:
                mvn verify -Pit
            Activating this profile flips skip.boot.its to false, so the
            spring-boot-maven-plugin start/stop executions boot the live app on
            http://localhost:8080 for the integration-test phase, and
            maven-failsafe-plugin runs the *IT classes against it. First run
            (or after an intentional UI change) generate visual baselines with:
                mvn verify -Pit -Dplaywright.snapshotsUpdate=true
        -->
        <profile>
            <id>it</id>
            <properties>
                <skip.boot.its>false</skip.boot.its>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.5.2</version>
                        <configuration>
                            <includes>
                                <include>**/*IT.java</include>
                            </includes>
                        </configuration>
                        <executions>
                            <execution>
                                <id>integration-tests</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>quality</id>
            <properties>
                <!-- Report-mode (non-failing) defaults - see quality-gate.md's toggle table. -->
                <spotbugs.failOnError>false</spotbugs.failOnError>
                <pmd.failOnViolation>false</pmd.failOnViolation>
                <checkstyle.failOnViolation>false</checkstyle.failOnViolation>
                <jacoco.haltOnFailure>false</jacoco.haltOnFailure>
                <jacoco.line.minimum>0.00</jacoco.line.minimum>
                <!-- 11 is above the CVSS v3 max of 10.0, so this effectively never fails the build. -->
                <dependency.check.failBuildOnCVSS>11</dependency.check.failBuildOnCVSS>
            </properties>
            <build>
                <plugins>

                    <!-- SpotBugs + FindSecBugs: bugs / correctness + security vulnerabilities (SAST). -->
                    <plugin>
                        <groupId>com.github.spotbugs</groupId>
                        <artifactId>spotbugs-maven-plugin</artifactId>
                        <version>4.9.6.0</version>
                        <configuration>
                            <effort>Max</effort>
                            <threshold>Medium</threshold>
                            <failOnError>${spotbugs.failOnError}</failOnError>
                            <excludeFilterFile>config/spotbugs-exclude.xml</excludeFilterFile>
                            <!-- Produces target/spotbugsSarif.json alongside the default
                                 target/spotbugsXml.xml + target/spotbugs.html reports (the plugin
                                 does not use a generic <formats> list; SARIF output is its own
                                 dedicated switch). -->
                            <sarifOutput>true</sarifOutput>
                            <htmlOutput>true</htmlOutput>
                            <!-- Default outputDirectory is target/site; override so the HTML
                                 report lands directly under target/ (spotbugs.html), matching the
                                 java-quality.yml artifact glob target/spotbugs*.html. -->
                            <outputDirectory>${project.build.directory}</outputDirectory>
                            <plugins>
                                <plugin>
                                    <groupId>com.h3xstream.findsecbugs</groupId>
                                    <artifactId>findsecbugs-plugin</artifactId>
                                    <version>1.13.0</version>
                                </plugin>
                            </plugins>
                        </configuration>
                        <executions>
                            <execution>
                                <id>spotbugs-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- PMD + CPD: code smells / conventions + duplicated-code detection. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-pmd-plugin</artifactId>
                        <version>3.27.0</version>
                        <configuration>
                            <rulesets>
                                <ruleset>config/pmd-ruleset.xml</ruleset>
                            </rulesets>
                            <failOnViolation>${pmd.failOnViolation}</failOnViolation>
                            <printFailingErrors>true</printFailingErrors>
                            <linkXRef>false</linkXRef>
                        </configuration>
                        <executions>
                            <execution>
                                <id>pmd-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>pmd</goal>
                                    <goal>cpd</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Checkstyle: code smells / conventions. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-checkstyle-plugin</artifactId>
                        <version>3.6.0</version>
                        <configuration>
                            <configLocation>config/checkstyle.xml</configLocation>
                            <failOnViolation>${checkstyle.failOnViolation}</failOnViolation>
                            <violationSeverity>warning</violationSeverity>
                            <includeTestSourceDirectory>true</includeTestSourceDirectory>
                            <consoleOutput>true</consoleOutput>
                        </configuration>
                        <executions>
                            <execution>
                                <id>checkstyle-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- JaCoCo: test coverage (report + threshold check, non-failing by default). -->
                    <plugin>
                        <groupId>org.jacoco</groupId>
                        <artifactId>jacoco-maven-plugin</artifactId>
                        <version>0.8.13</version>
                        <executions>
                            <execution>
                                <id>jacoco-prepare-agent</id>
                                <goals>
                                    <goal>prepare-agent</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>jacoco-report</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>report</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>jacoco-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                                <configuration>
                                    <haltOnFailure>${jacoco.haltOnFailure}</haltOnFailure>
                                    <rules>
                                        <rule>
                                            <element>BUNDLE</element>
                                            <limits>
                                                <limit>
                                                    <counter>LINE</counter>
                                                    <value>COVEREDRATIO</value>
                                                    <minimum>${jacoco.line.minimum}</minimum>
                                                </limit>
                                            </limits>
                                        </rule>
                                    </rules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- OWASP Dependency-Check: vulnerable-dependency (CVE) scanning. -->
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>12.1.3</version>
                        <configuration>
                            <failBuildOnCVSS>${dependency.check.failBuildOnCVSS}</failBuildOnCVSS>
                            <formats>
                                <format>HTML</format>
                                <format>XML</format>
                                <format>SARIF</format>
                            </formats>
                            <!--
                                DEVIATION (see task report): this sandboxed execution environment
                                cannot complete the OWASP NVD API handshake (SSLHandshakeException
                                / PKIX path building failed - no outbound trust to
                                services.nvd.nist.gov from here), so dependency-check-maven cannot
                                build/update its local CVE database and the `check` goal fails
                                with a "NoDataException: No documents exist" before
                                failBuildOnCVSS is ever evaluated - this is a genuine environment
                                network restriction, not a pom misconfiguration. autoUpdate stays
                                at its default (true) so a normal (non-sandboxed) run, e.g. in the
                                java-quality.yml CI workflow which does have outbound internet
                                access, refreshes the CVE database and produces real findings.
                            -->
                            <!-- Analyzers requiring outbound network calls are opt-in; disabled here
                                 so the gate stays usable offline / behind a locked-down proxy. -->
                            <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                            <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                            <!-- Sonatype OSS Index now rejects anonymous requests with HTTP 401;
                                 disabled so the gate does not fail without an OSS Index account. NVD
                                 remains the CVE source. -->
                            <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                        </configuration>
                        <executions>
                            <execution>
                                <id>dependency-check</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>
    </profiles>

</project>
