<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>crm-minimal</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>MiniCRM (aiup-vaadin-holon demo)</name>
    <description>Minimal CRM demo built with the aiup-vaadin-holon plugin (Holon Platform + Vaadin Flow)</description>

    <!--
        NOTE: deliberately NOT inheriting from com.holon-platform.multi-tenancy:holon-multi-tenancy-root
        as <parent>. That root pom's own dependencyManagement declares every
        holon-multi-tenancy module version as ${project.version}; once inherited, entries
        already present from that inheritance take precedence over the same GA coming from
        an imported BOM (Maven does not let imported entries override ones already merged in
        from a parent), so ${project.version} still resolves against THIS project's version
        instead of the framework's actual 1.0.0. Importing the BOM standalone (as the BOM's
        own pom.xml documents) avoids the conflict entirely.
    -->
    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.0</spring-boot.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.holon-platform.multi-tenancy</groupId>
                <artifactId>holon-multi-tenancy-bom</artifactId>
                <version>1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>

        <!--  All-in-one SaaS starter (pulls every module)  -->
        <dependency>
            <groupId>com.holon-platform.multi-tenancy</groupId>
            <artifactId>holon-starter-vaadin-flow-multi-tenancy</artifactId>
        </dependency>

        

        <!--  Spring Boot web (embedded Tomcat, DispatcherServlet)  -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--  JPA + H2 (replaces all in-memory service implementations)  -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--  AOP (enables @RateLimit and @Audited aspects)  -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
            <version>3.5.14</version>
            <!-- version managed by spring-boot-dependencies BOM -->
        </dependency>

        <!-- Dev tools (hot-reload for development) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-dev</artifactId>
            <optional>true</optional>
        </dependency>

    </dependencies>

    <build>
        <plugins>

            <!--
                Compiler  explicitly declared so IntelliJ recognises the source level
                even before the parent pluginManagement is fully resolved.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!--
                Spring Boot plugin  produces the runnable fat-jar (repackage),
                and exposes the run / start / stop goals for development and
                integration-test lifecycles.
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <!-- Explicit main class so the plugin never has to guess. -->
                    <mainClass>com.holonplatform.multitenancy.demo.DemoApplication</mainClass>
                </configuration>
                <executions>
                    <!--
                        start/stop are skipped by default (skip.boot.its=true).
                        They are gated behind a property so that `mvn install`
                        does NOT try to boot the full Vaadin app during the
                        integration-test phase (Vaadin dev-mode scanning takes
                        > 30 s and always exceeded the default JMX timeout).

                        To run integration tests with the live server:
                            mvn verify -Dskip.boot.its=false
                    -->
                    <execution>
                        <id>pre-integration-test</id>
                        <goals>
                            <goal>start</goal>
                        </goals>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                    <execution>
                        <id>post-integration-test</id>
                        <goals>
                            <goal>stop</goal>
                        </goals>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

        </plugins>
    </build>

</project>
