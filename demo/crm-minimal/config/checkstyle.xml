<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
    Lightweight Checkstyle ruleset for crm-minimal, adapted from Checkstyle's bundled
    "sun_checks.xml" starter with a few relaxations for Holon Platform + Vaadin Flow's fluent
    builder style (long method-chain expressions, package-visible fields used purely for
    same-package Browserless-test access such as NewCustomerView#draft/taxCodeInput and
    CustomerMasterDetailView#id). Runs in report mode (checkstyle.failOnViolation=false), so
    findings surface without blocking the build.
-->
<module name="Checker">

    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- Excludes Vaadin/Maven generated sources (flow-build-info.json is not Java; this guards
         any future generated-Java directory, e.g. target/generated-sources). -->
    <module name="BeforeExecutionExclusionFileFilter">
        <property name="fileNamePattern" value="module\-info\.java$"/>
    </module>

    <module name="FileTabCharacter"/>

    <module name="TreeWalker">

        <!-- Naming conventions -->
        <module name="TypeName"/>
        <module name="MethodName"/>
        <module name="LocalVariableName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="ConstantName"/>

        <!-- Imports -->
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>

        <!-- Whitespace / formatting (kept lenient - not the goal of this gate) -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
        </module>

        <!-- Blocks -->
        <module name="NeedBraces"/>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>

        <!-- Coding -->
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>

        <!-- Class design - relaxed vs. sun_checks.xml's defaults for Holon/Vaadin view classes,
             which legitimately expose package-visible (not always private) fields for
             same-package Browserless-test access; VisibilityModifier is intentionally NOT
             configured to hard-fail on package-private fields (default protectedAllowed=false /
             packageAllowed=false would otherwise flag every one of them). -->
        <module name="VisibilityModifier">
            <property name="packageAllowed" value="true"/>
            <property name="protectedAllowed" value="true"/>
        </module>
        <module name="FinalClass"/>

        <!-- Miscellaneous -->
        <module name="ArrayTypeStyle"/>
        <module name="TodoComment">
            <property name="severity" value="info"/>
        </module>
        <module name="UpperEll"/>

    </module>

</module>
